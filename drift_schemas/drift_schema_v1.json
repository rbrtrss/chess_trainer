    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NULL, \"status\" TEXT NOT NULL, \"current_index\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "session_positions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"session_positions\" (\"session_id\" TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"ordinal\" INTEGER NOT NULL, \"position_id\" TEXT NOT NULL, \"initial_fen\" TEXT NOT NULL, \"solution_pgn\" TEXT NOT NULL, \"metadata_json\" TEXT NOT NULL, PRIMARY KEY (\"session_id\", \"ordinal\"));"
        }
      ]
    },
    {
      "name": "attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attempts\" (\"session_id\" TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"position_id\" TEXT NOT NULL, \"tree_pgn\" TEXT NOT NULL, \"duration_ms\" INTEGER NOT NULL, \"committed_at\" INTEGER NOT NULL, PRIMARY KEY (\"session_id\", \"position_id\"));"
        }
      ]
    },
    {
      "name": "grades",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"grades\" (\"session_id\" TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"position_id\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"graded_at\" INTEGER NOT NULL, PRIMARY KEY (\"session_id\", \"position_id\"));"
        }
      ]
    },
